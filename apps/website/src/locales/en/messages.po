#: src/lib/github-learning/lessons.ts:80
#: src/app/[locale]/(courses)/courses/github/layout.tsx:15
msgid "Git & GitHub"
msgstr "Git & GitHub"

#: src/lib/github-learning/lessons.ts:81
msgid "Learn Git fundamentals, visual branching, practical GitHub collaboration, and safe publishing through Development, UAT, and Production."
msgstr "Learn Git fundamentals, visual branching, practical GitHub collaboration, and safe publishing through Development, UAT, and Production."

#: src/lib/github-learning/lessons.ts:86
msgid "Git foundations"
msgstr "Git foundations"

#: src/lib/github-learning/lessons.ts:87
msgid "Understand repositories, changes, staging, commits, and history."
msgstr "Understand repositories, changes, staging, commits, and history."

#: src/lib/github-learning/lessons.ts:91
msgid "How Git thinks"
msgstr "How Git thinks"

#: src/lib/github-learning/lessons.ts:92
msgid "Understand snapshots, repositories, and the three places where your work can live."
msgstr "Understand snapshots, repositories, and the three places where your work can live."

#: src/lib/github-learning/lessons.ts:97
msgid "Git records snapshots of a project. Your working tree contains current files, the staging area selects the next snapshot, and commits preserve completed snapshots in history."
msgstr "Git records snapshots of a project. Your working tree contains current files, the staging area selects the next snapshot, and commits preserve completed snapshots in history."

#: src/lib/github-learning/lessons.ts:102
msgid "Ask Git where your files are in the working tree and staging workflow."
msgstr "Ask Git where your files are in the working tree and staging workflow."

#: src/lib/github-learning/lessons.ts:107
msgid "Think of Git as a timeline you intentionally build, not as an automatic backup service."
msgstr "Think of Git as a timeline you intentionally build, not as an automatic backup service."

#: src/lib/github-learning/lessons.ts:114
msgid "Inspect your work"
msgstr "Inspect your work"

#: src/lib/github-learning/lessons.ts:115
msgid "Read repository status before deciding what to do next."
msgstr "Read repository status before deciding what to do next."

#: src/lib/github-learning/lessons.ts:120
msgid "A clean status means tracked files match the current commit. Modified, deleted, and untracked files are working-tree changes that are not yet part of a commit."
msgstr "A clean status means tracked files match the current commit. Modified, deleted, and untracked files are working-tree changes that are not yet part of a commit."

#: src/lib/github-learning/lessons.ts:125
msgid "Display the current branch and summarize staged and unstaged changes."
msgstr "Display the current branch and summarize staged and unstaged changes."

#: src/lib/github-learning/lessons.ts:130
msgid "Run status often. It is a safe, read-only command and one of the best ways to stay oriented."
msgstr "Run status often. It is a safe, read-only command and one of the best ways to stay oriented."

#: src/lib/github-learning/lessons.ts:137
msgid "Stage changes"
msgstr "Stage changes"

#: src/lib/github-learning/lessons.ts:138
msgid "Select exactly which file changes belong in the next commit."
msgstr "Select exactly which file changes belong in the next commit."

#: src/lib/github-learning/lessons.ts:143
msgid "The staging area lets you prepare a focused commit. Staging a file copies its current change into the proposed snapshot without changing the file itself."
msgstr "The staging area lets you prepare a focused commit. Staging a file copies its current change into the proposed snapshot without changing the file itself."

#: src/lib/github-learning/lessons.ts:148
msgid "Stage the current README change for the next commit."
msgstr "Stage the current README change for the next commit."

#: src/lib/github-learning/lessons.ts:153
msgid "Review status after staging so unrelated changes do not accidentally enter the same commit."
msgstr "Review status after staging so unrelated changes do not accidentally enter the same commit."

#: src/lib/github-learning/lessons.ts:159
msgid "Prepare notes for a commit"
msgstr "Prepare notes for a commit"

#: src/lib/github-learning/lessons.ts:161
msgid "Inspect the repository status."
msgstr "Inspect the repository status."

#: src/lib/github-learning/lessons.ts:162
msgid "Stage notes.md without committing it."
msgstr "Stage notes.md without committing it."

#: src/lib/github-learning/lessons.ts:164
msgid "Use git add followed by the file path."
msgstr "Use git add followed by the file path."

#: src/lib/github-learning/lessons.ts:178
msgid "Create meaningful commits"
msgstr "Create meaningful commits"

#: src/lib/github-learning/lessons.ts:179
msgid "Save a focused snapshot with a useful message."
msgstr "Save a focused snapshot with a useful message."

#: src/lib/github-learning/lessons.ts:184
msgid "A commit stores the staged snapshot, its author, a message, and a link to its parent. Small, focused commits are easier to review and undo."
msgstr "A commit stores the staged snapshot, its author, a message, and a link to its parent. Small, focused commits are easier to review and undo."

#: src/lib/github-learning/lessons.ts:189
msgid "Create a commit from staged changes with a concise action-oriented message."
msgstr "Create a commit from staged changes with a concise action-oriented message."

#: src/lib/github-learning/lessons.ts:194
msgid "A helpful commit message explains why the project changed, not only which files changed."
msgstr "A helpful commit message explains why the project changed, not only which files changed."

#: src/lib/github-learning/lessons.ts:200
msgid "Commit the staged notes"
msgstr "Commit the staged notes"

#: src/lib/github-learning/lessons.ts:202
msgid "Confirm that notes.md is staged."
msgstr "Confirm that notes.md is staged."

#: src/lib/github-learning/lessons.ts:203
msgid "Create a commit with a clear message."
msgstr "Create a commit with a clear message."

#: src/lib/github-learning/lessons.ts:205
#: src/lib/github-learning/lessons.ts:679
msgid "Use git commit with the -m message option."
msgstr "Use git commit with the -m message option."

#: src/lib/github-learning/lessons.ts:218
msgid "History and branches"
msgstr "History and branches"

#: src/lib/github-learning/lessons.ts:219
msgid "Explore history and develop work safely on parallel branches."
msgstr "Explore history and develop work safely on parallel branches."

#: src/lib/github-learning/lessons.ts:223
msgid "Read project history"
msgstr "Read project history"

#: src/lib/github-learning/lessons.ts:224
msgid "Follow commits and understand parent relationships."
msgstr "Follow commits and understand parent relationships."

#: src/lib/github-learning/lessons.ts:229
msgid "Commit history is a chain of snapshots. Each normal commit points to its parent, allowing Git to reconstruct how the project developed."
msgstr "Commit history is a chain of snapshots. Each normal commit points to its parent, allowing Git to reconstruct how the project developed."

#: src/lib/github-learning/lessons.ts:234
msgid "List commits from the current branch tip backward through its parents."
msgstr "List commits from the current branch tip backward through its parents."

#: src/lib/github-learning/lessons.ts:239
msgid "Commit identifiers are content-based references. A short identifier is usually enough for local discussion."
msgstr "Commit identifiers are content-based references. A short identifier is usually enough for local discussion."

#: src/lib/github-learning/lessons.ts:246
msgid "Create branches"
msgstr "Create branches"

#: src/lib/github-learning/lessons.ts:247
msgid "Create a lightweight name for an independent line of work."
msgstr "Create a lightweight name for an independent line of work."

#: src/lib/github-learning/lessons.ts:252
msgid "A branch is a movable name pointing to a commit. New commits advance the current branch while other branches remain at their previous commits."
msgstr "A branch is a movable name pointing to a commit. New commits advance the current branch while other branches remain at their previous commits."

#: src/lib/github-learning/lessons.ts:257
msgid "Create a feature branch at the current commit without switching to it."
msgstr "Create a feature branch at the current commit without switching to it."

#: src/lib/github-learning/lessons.ts:262
msgid "Use short descriptive branch names such as feature/profile-card or fix/login-timeout."
msgstr "Use short descriptive branch names such as feature/profile-card or fix/login-timeout."

#: src/lib/github-learning/lessons.ts:268
msgid "Create a feature branch"
msgstr "Create a feature branch"

#: src/lib/github-learning/lessons.ts:270
msgid "Create a branch named feature at the current commit."
msgstr "Create a branch named feature at the current commit."

#: src/lib/github-learning/lessons.ts:271
msgid "Stay on the main branch after creating it."
msgstr "Stay on the main branch after creating it."

#: src/lib/github-learning/lessons.ts:273
msgid "Use git branch followed by the new branch name."
msgstr "Use git branch followed by the new branch name."

#: src/lib/github-learning/lessons.ts:284
msgid "Switch branches"
msgstr "Switch branches"

#: src/lib/github-learning/lessons.ts:285
msgid "Move HEAD between branches and understand which branch receives new commits."
msgstr "Move HEAD between branches and understand which branch receives new commits."

#: src/lib/github-learning/lessons.ts:290
msgid "HEAD identifies your current location. When HEAD points to a branch, the next commit advances that branch."
msgstr "HEAD identifies your current location. When HEAD points to a branch, the next commit advances that branch."

#: src/lib/github-learning/lessons.ts:295
msgid "Create a branch named feature and switch to it in one command."
msgstr "Create a branch named feature and switch to it in one command."

#: src/lib/github-learning/lessons.ts:300
msgid "Commit or safely store unfinished changes before switching when those changes conflict with the destination branch."
msgstr "Commit or safely store unfinished changes before switching when those changes conflict with the destination branch."

#: src/lib/github-learning/lessons.ts:306
msgid "Move to the feature branch"
msgstr "Move to the feature branch"

#: src/lib/github-learning/lessons.ts:308
msgid "Inspect the available branches."
msgstr "Inspect the available branches."

#: src/lib/github-learning/lessons.ts:309
msgid "Switch from main to the existing feature branch."
msgstr "Switch from main to the existing feature branch."

#: src/lib/github-learning/lessons.ts:311
msgid "Use git switch followed by feature."
msgstr "Use git switch followed by feature."

#: src/lib/github-learning/lessons.ts:323
msgid "GitHub collaboration"
msgstr "GitHub collaboration"

#: src/lib/github-learning/lessons.ts:324
msgid "Connect local history to remotes, share branches, and collaborate through pull requests."
msgstr "Connect local history to remotes, share branches, and collaborate through pull requests."

#: src/lib/github-learning/lessons.ts:328
msgid "Understand remotes"
msgstr "Understand remotes"

#: src/lib/github-learning/lessons.ts:329
msgid "Understand how local repositories refer to shared repositories."
msgstr "Understand how local repositories refer to shared repositories."

#: src/lib/github-learning/lessons.ts:334
msgid "A remote is a named connection to another Git repository. The conventional name origin usually identifies the repository you cloned."
msgstr "A remote is a named connection to another Git repository. The conventional name origin usually identifies the repository you cloned."

#: src/lib/github-learning/lessons.ts:339
msgid "List remote names and the URLs used to exchange repository data."
msgstr "List remote names and the URLs used to exchange repository data."

#: src/lib/github-learning/lessons.ts:344
msgid "Bring newer commits from origin/main into the current local branch."
msgstr "Bring newer commits from origin/main into the current local branch."

#: src/lib/github-learning/lessons.ts:349
msgid "A GitHub repository is a remote Git repository plus collaboration features such as issues, reviews, and pull requests."
msgstr "A GitHub repository is a remote Git repository plus collaboration features such as issues, reviews, and pull requests."

#: src/lib/github-learning/lessons.ts:355
msgid "Pull remote work"
msgstr "Pull remote work"

#: src/lib/github-learning/lessons.ts:357
msgid "Notice that local main is one commit behind origin/main."
msgstr "Notice that local main is one commit behind origin/main."

#: src/lib/github-learning/lessons.ts:358
msgid "Pull origin/main into your local main branch."
msgstr "Pull origin/main into your local main branch."

#: src/lib/github-learning/lessons.ts:359
msgid "Confirm that the package arrives on the local computer and main reaches the latest commit."
msgstr "Confirm that the package arrives on the local computer and main reaches the latest commit."

#: src/lib/github-learning/lessons.ts:362
msgid "Use git pull followed by the remote and branch names."
msgstr "Use git pull followed by the remote and branch names."

#: src/lib/github-learning/lessons.ts:382
msgid "Share branches"
msgstr "Share branches"

#: src/lib/github-learning/lessons.ts:383
msgid "Publish a local branch to a remote repository."
msgstr "Publish a local branch to a remote repository."

#: src/lib/github-learning/lessons.ts:388
msgid "Pushing transfers commits and updates a branch reference on the remote. It does not upload arbitrary working-tree files that have not been committed."
msgstr "Pushing transfers commits and updates a branch reference on the remote. It does not upload arbitrary working-tree files that have not been committed."

#: src/lib/github-learning/lessons.ts:393
msgid "Publish the local feature branch to the simulated origin remote."
msgstr "Publish the local feature branch to the simulated origin remote."

#: src/lib/github-learning/lessons.ts:398
msgid "Never commit tokens, passwords, private keys, or environment secrets before pushing."
msgstr "Never commit tokens, passwords, private keys, or environment secrets before pushing."

#: src/lib/github-learning/lessons.ts:404
msgid "Publish the feature branch"
msgstr "Publish the feature branch"

#: src/lib/github-learning/lessons.ts:406
msgid "Confirm that feature is the current branch."
msgstr "Confirm that feature is the current branch."

#: src/lib/github-learning/lessons.ts:407
msgid "Push feature to the origin remote."
msgstr "Push feature to the origin remote."

#: src/lib/github-learning/lessons.ts:409
msgid "Provide both the remote and branch to git push."
msgstr "Provide both the remote and branch to git push."

#: src/lib/github-learning/lessons.ts:423
msgid "Submit code"
msgstr "Submit code"

#: src/lib/github-learning/lessons.ts:424
msgid "Commit work on a focused branch and publish it for review on GitHub."
msgstr "Commit work on a focused branch and publish it for review on GitHub."

#: src/lib/github-learning/lessons.ts:429
msgid "A commit always advances the branch currently checked out. To submit work safely, switch to a feature branch, stage and commit the intended files, then push that branch to GitHub."
msgstr "A commit always advances the branch currently checked out. To submit work safely, switch to a feature branch, stage and commit the intended files, then push that branch to GitHub."

#: src/lib/github-learning/lessons.ts:434
msgid "Create and check out a focused branch before changing shared history."
msgstr "Create and check out a focused branch before changing shared history."

#: src/lib/github-learning/lessons.ts:439
msgid "Stage only the new greeting file for this commit."
msgstr "Stage only the new greeting file for this commit."

#: src/lib/github-learning/lessons.ts:444
msgid "Record the staged code on the currently checked-out feature branch."
msgstr "Record the staged code on the currently checked-out feature branch."

#: src/lib/github-learning/lessons.ts:449
msgid "Publish the branch and connect it to its matching origin branch."
msgstr "Publish the branch and connect it to its matching origin branch."

#: src/lib/github-learning/lessons.ts:454
msgid "After pushing, open a pull request on GitHub so teammates can review the branch before it is merged into main."
msgstr "After pushing, open a pull request on GitHub so teammates can review the branch before it is merged into main."

#: src/lib/github-learning/lessons.ts:460
msgid "Publish a branch"
msgstr "Publish a branch"

#: src/lib/github-learning/lessons.ts:462
msgid "Confirm that feature/github-submit is the current branch."
msgstr "Confirm that feature/github-submit is the current branch."

#: src/lib/github-learning/lessons.ts:463
msgid "Stage src/greeting.ts and commit it with a clear message."
msgstr "Stage src/greeting.ts and commit it with a clear message."

#: src/lib/github-learning/lessons.ts:464
msgid "Push feature/github-submit to origin with an upstream connection."
msgstr "Push feature/github-submit to origin with an upstream connection."

#: src/lib/github-learning/lessons.ts:467
msgid "Use git add before git commit."
msgstr "Use git add before git commit."

#: src/lib/github-learning/lessons.ts:468
msgid "Use git push -u origin followed by the current branch name."
msgstr "Use git push -u origin followed by the current branch name."

#: src/lib/github-learning/lessons.ts:490
msgid "Pull requests"
msgstr "Pull requests"

#: src/lib/github-learning/lessons.ts:491
msgid "Use a pull request to explain, review, and merge a branch."
msgstr "Use a pull request to explain, review, and merge a branch."

#: src/lib/github-learning/lessons.ts:496
msgid "A pull request proposes merging one branch into another. It creates a shared place for context, automated checks, discussion, and code review."
msgstr "A pull request proposes merging one branch into another. It creates a shared place for context, automated checks, discussion, and code review."

#: src/lib/github-learning/lessons.ts:501
msgid "In a real authenticated repository, GitHub CLI can open a pull request for your published branch."
msgstr "In a real authenticated repository, GitHub CLI can open a pull request for your published branch."

#: src/lib/github-learning/lessons.ts:506
msgid "Keep pull requests focused, explain the reason for the change, and include clear verification steps."
msgstr "Keep pull requests focused, explain the reason for the change, and include clear verification steps."

#: src/lib/github-learning/lessons.ts:515
msgid "Everyday workflow"
msgstr "Everyday workflow"

#: src/lib/github-learning/lessons.ts:516
msgid "Review collaboration changes and build a safe daily Git routine."
msgstr "Review collaboration changes and build a safe daily Git routine."

#: src/lib/github-learning/lessons.ts:520
msgid "Review and merge"
msgstr "Review and merge"

#: src/lib/github-learning/lessons.ts:521
msgid "Evaluate a pull request and choose a clear merge strategy."
msgstr "Evaluate a pull request and choose a clear merge strategy."

#: src/lib/github-learning/lessons.ts:526
msgid "Review checks behavior, clarity, tests, and security rather than only scanning changed lines. Resolve important feedback before merging."
msgstr "Review checks behavior, clarity, tests, and security rather than only scanning changed lines. Resolve important feedback before merging."

#: src/lib/github-learning/lessons.ts:531
msgid "Inspect the resulting commit history after a branch is merged."
msgstr "Inspect the resulting commit history after a branch is merged."

#: src/lib/github-learning/lessons.ts:536
msgid "Merge commits preserve branch structure, squash merges create one focused commit, and rebase merges produce a linear history."
msgstr "Merge commits preserve branch structure, squash merges create one focused commit, and rebase merges produce a linear history."

#: src/lib/github-learning/lessons.ts:543
msgid "Daily workflow"
msgstr "Daily workflow"

#: src/lib/github-learning/lessons.ts:544
msgid "Combine inspection, focused commits, branches, and review into a repeatable routine."
msgstr "Combine inspection, focused commits, branches, and review into a repeatable routine."

#: src/lib/github-learning/lessons.ts:549
msgid "Start by checking status, create a focused branch, make and review changes, stage intentionally, commit clearly, push the branch, and open a pull request."
msgstr "Start by checking status, create a focused branch, make and review changes, stage intentionally, commit clearly, push the branch, and open a pull request."

#: src/lib/github-learning/lessons.ts:554
msgid "Begin and end work by confirming your branch and the state of your working tree."
msgstr "Begin and end work by confirming your branch and the state of your working tree."

#: src/lib/github-learning/lessons.ts:559
msgid "Before destructive recovery commands, stop and inspect status and history. Preserve work on a branch or commit whenever possible."
msgstr "Before destructive recovery commands, stop and inspect status and history. Preserve work on a branch or commit whenever possible."

#: src/lib/github-learning/lessons.ts:565
msgid "Practice a safe branch workflow"
msgstr "Practice a safe branch workflow"

#: src/lib/github-learning/lessons.ts:567
msgid "Create and switch to a branch named daily-work."
msgstr "Create and switch to a branch named daily-work."

#: src/lib/github-learning/lessons.ts:568
msgid "Publish daily-work to origin."
msgstr "Publish daily-work to origin."

#: src/lib/github-learning/lessons.ts:569
msgid "Finish with a clean working tree."
msgstr "Finish with a clean working tree."

#: src/lib/github-learning/lessons.ts:572
msgid "The -c option creates a branch while switching."
msgstr "The -c option creates a branch while switching."

#: src/lib/github-learning/lessons.ts:573
msgid "Push the new branch after switching to it."
msgstr "Push the new branch after switching to it."

#: src/lib/github-learning/lessons.ts:593
msgid "Parallel team workflows"
msgstr "Parallel team workflows"

#: src/lib/github-learning/lessons.ts:594
msgid "Follow several developers as their branches keep moving independently from the same stable main line."
msgstr "Follow several developers as their branches keep moving independently from the same stable main line."

#: src/lib/github-learning/lessons.ts:598
msgid "Parallel history"
msgstr "Parallel history"

#: src/lib/github-learning/lessons.ts:599
msgid "Understand a repository where feature and hotfix work continue beside main."
msgstr "Understand a repository where feature and hotfix work continue beside main."

#: src/lib/github-learning/lessons.ts:604
msgid "Alice has two profile commits while Bob has an urgent login fix. Both branches share the same stable main commit, but each branch pointer advances only when its owner commits."
msgstr "Alice has two profile commits while Bob has an urgent login fix. Both branches share the same stable main commit, but each branch pointer advances only when its owner commits."

#: src/lib/github-learning/lessons.ts:609
msgid "Read the history reachable from the current branch while the visual map keeps the other active branches visible."
msgstr "Read the history reachable from the current branch while the visual map keeps the other active branches visible."

#: src/lib/github-learning/lessons.ts:614
msgid "Parallel lanes do not mean duplicated repositories. They are lightweight pointers into one connected commit history."
msgstr "Parallel lanes do not mean duplicated repositories. They are lightweight pointers into one connected commit history."

#: src/lib/github-learning/lessons.ts:620
msgid "Navigate the team's branch map"
msgstr "Navigate the team's branch map"

#: src/lib/github-learning/lessons.ts:622
msgid "Inspect the three active branch lanes."
msgstr "Inspect the three active branch lanes."

#: src/lib/github-learning/lessons.ts:623
msgid "Switch from main to feature/profile without changing its commits."
msgstr "Switch from main to feature/profile without changing its commits."

#: src/lib/github-learning/lessons.ts:626
msgid "Use git branch to list local branches."
msgstr "Use git branch to list local branches."

#: src/lib/github-learning/lessons.ts:627
msgid "Use git switch followed by the full branch name."
msgstr "Use git switch followed by the full branch name."

#: src/lib/github-learning/lessons.ts:649
msgid "Continue feature"
msgstr "Continue feature"

#: src/lib/github-learning/lessons.ts:650
msgid "Add another focused commit without moving main or the hotfix branch."
msgstr "Add another focused commit without moving main or the hotfix branch."

#: src/lib/github-learning/lessons.ts:655
msgid "Alice can continue the profile branch after her earlier commits. The new commit extends only feature/profile; main and fix/login stay at their current snapshots."
msgstr "Alice can continue the profile branch after her earlier commits. The new commit extends only feature/profile; main and fix/login stay at their current snapshots."

#: src/lib/github-learning/lessons.ts:660
msgid "Commit the staged profile test on Alice's current branch."
msgstr "Commit the staged profile test on Alice's current branch."

#: src/lib/github-learning/lessons.ts:665
msgid "Watch the feature lane grow by one node while the other branch tips remain fixed."
msgstr "Watch the feature lane grow by one node while the other branch tips remain fixed."

#: src/lib/github-learning/lessons.ts:671
msgid "Extend Alice's feature history"
msgstr "Extend Alice's feature history"

#: src/lib/github-learning/lessons.ts:673
msgid "Confirm that feature/profile is the current branch."
msgstr "Confirm that feature/profile is the current branch."

#: src/lib/github-learning/lessons.ts:674
msgid "Commit the staged profile test with a clear message."
msgstr "Commit the staged profile test with a clear message."

#: src/lib/github-learning/lessons.ts:675
msgid "Keep main and fix/login unchanged."
msgstr "Keep main and fix/login unchanged."

#: src/lib/github-learning/lessons.ts:678
msgid "The test file is already staged."
msgstr "The test file is already staged."

#: src/lib/github-learning/lessons.ts:692
msgid "Continue hotfix"
msgstr "Continue hotfix"

#: src/lib/github-learning/lessons.ts:693
msgid "Advance the fix branch independently while feature work remains untouched."
msgstr "Advance the fix branch independently while feature work remains untouched."

#: src/lib/github-learning/lessons.ts:698
msgid "Bob adds a focused login regression test on fix/login. This creates another hotfix node without interrupting Alice's longer-running feature branch."
msgstr "Bob adds a focused login regression test on fix/login. This creates another hotfix node without interrupting Alice's longer-running feature branch."

#: src/lib/github-learning/lessons.ts:703
msgid "Commit the staged regression test on Bob's hotfix branch."
msgstr "Commit the staged regression test on Bob's hotfix branch."

#: src/lib/github-learning/lessons.ts:708
msgid "Urgency should change priority, not quality. Keep the hotfix small, tested, and ready for review."
msgstr "Urgency should change priority, not quality. Keep the hotfix small, tested, and ready for review."

#: src/lib/github-learning/lessons.ts:714
msgid "Extend Bob's hotfix history"
msgstr "Extend Bob's hotfix history"

#: src/lib/github-learning/lessons.ts:716
msgid "Confirm that fix/login is the current branch."
msgstr "Confirm that fix/login is the current branch."

#: src/lib/github-learning/lessons.ts:717
msgid "Commit the staged login regression test."
msgstr "Commit the staged login regression test."

#: src/lib/github-learning/lessons.ts:718
msgid "Keep main and feature/profile unchanged."
msgstr "Keep main and feature/profile unchanged."

#: src/lib/github-learning/lessons.ts:721
msgid "The regression test is already staged."
msgstr "The regression test is already staged."

#: src/lib/github-learning/lessons.ts:722
msgid "Use a concise commit message describing the test."
msgstr "Use a concise commit message describing the test."

#: src/lib/github-learning/lessons.ts:735
msgid "Publish branches"
msgstr "Publish branches"

#: src/lib/github-learning/lessons.ts:736
msgid "Share both independent lines of work without moving stable main."
msgstr "Share both independent lines of work without moving stable main."

#: src/lib/github-learning/lessons.ts:741
msgid "Publishing each branch creates a matching remote pointer. Teammates and automated checks can then review both lines of work while origin/main remains stable."
msgstr "Publishing each branch creates a matching remote pointer. Teammates and automated checks can then review both lines of work while origin/main remains stable."

#: src/lib/github-learning/lessons.ts:746
msgid "Publish Alice's feature branch without merging it into main."
msgstr "Publish Alice's feature branch without merging it into main."

#: src/lib/github-learning/lessons.ts:751
msgid "Push each named branch explicitly when coordinating several active lines of work."
msgstr "Push each named branch explicitly when coordinating several active lines of work."

#: src/lib/github-learning/lessons.ts:757
msgid "Share both team branches"
msgstr "Share both team branches"

#: src/lib/github-learning/lessons.ts:759
msgid "Push feature/profile to origin."
msgstr "Push feature/profile to origin."

#: src/lib/github-learning/lessons.ts:760
msgid "Push fix/login to origin."
msgstr "Push fix/login to origin."

#: src/lib/github-learning/lessons.ts:761
msgid "Leave main unchanged and the working tree clean."
msgstr "Leave main unchanged and the working tree clean."

#: src/lib/github-learning/lessons.ts:764
msgid "Use git push origin followed by each branch name."
msgstr "Use git push origin followed by each branch name."

#: src/lib/github-learning/lessons.ts:765
msgid "You can publish a named branch without switching to it."
msgstr "You can publish a named branch without switching to it."

#: src/lib/github-learning/lessons.ts:788
msgid "Publishing with Dev, UAT, and Production"
msgstr "Publishing with Dev, UAT, and Production"

#: src/lib/github-learning/lessons.ts:789
msgid "Use separate environments to move quickly, validate with stakeholders, and protect real customers."
msgstr "Use separate environments to move quickly, validate with stakeholders, and protect real customers."

#: src/lib/github-learning/lessons.ts:793
msgid "Development environment"
msgstr "Development environment"

#: src/lib/github-learning/lessons.ts:794
msgid "Use a fast, disposable environment for integration and early feedback."
msgstr "Use a fast, disposable environment for integration and early feedback."

#: src/lib/github-learning/lessons.ts:799
msgid "A shared Development environment runs recent accepted changes before they are release candidates. It favors speed, automatic deployment, useful logs, and data that can be safely reset."
msgstr "A shared Development environment runs recent accepted changes before they are release candidates. It favors speed, automatic deployment, useful logs, and data that can be safely reset."

#: src/lib/github-learning/lessons.ts:804
msgid "A team can publish its integration branch to trigger an automatic Development deployment."
msgstr "A team can publish its integration branch to trigger an automatic Development deployment."

#: src/lib/github-learning/lessons.ts:809
msgid "Take advantage of Development by experimenting early, integrating often, and fixing inexpensive failures before they reach testers."
msgstr "Take advantage of Development by experimenting early, integrating often, and fixing inexpensive failures before they reach testers."

#: src/lib/github-learning/lessons.ts:816
msgid "UAT environment"
msgstr "UAT environment"

#: src/lib/github-learning/lessons.ts:817
msgid "Validate a production-like release with the people who understand the business need."
msgstr "Validate a production-like release with the people who understand the business need."

#: src/lib/github-learning/lessons.ts:822
msgid "User Acceptance Testing gives product owners, QA, and selected users a stable release candidate. Its configuration should resemble Production while its data remains masked or safely representative."
msgstr "User Acceptance Testing gives product owners, QA, and selected users a stable release candidate. Its configuration should resemble Production while its data remains masked or safely representative."

#: src/lib/github-learning/lessons.ts:827
msgid "Publishing a release candidate can trigger deployment to UAT for acceptance and regression testing."
msgstr "Publishing a release candidate can trigger deployment to UAT for acceptance and regression testing."

#: src/lib/github-learning/lessons.ts:832
msgid "Take advantage of UAT to catch requirement misunderstandings and workflow problems that automated tests cannot recognize."
msgstr "Take advantage of UAT to catch requirement misunderstandings and workflow problems that automated tests cannot recognize."

#: src/lib/github-learning/lessons.ts:839
msgid "Production environment"
msgstr "Production environment"

#: src/lib/github-learning/lessons.ts:840
msgid "Release approved software to customers with monitoring and recovery controls."
msgstr "Release approved software to customers with monitoring and recovery controls."

#: src/lib/github-learning/lessons.ts:845
msgid "Production serves real customers and real data. Access is restricted, changes are deliberate, monitoring is continuous, and every release needs a tested rollback or recovery path."
msgstr "Production serves real customers and real data. Access is restricted, changes are deliberate, monitoring is continuous, and every release needs a tested rollback or recovery path."

#: src/lib/github-learning/lessons.ts:850
msgid "Teams commonly protect main and let an approved update initiate the Production release process."
msgstr "Teams commonly protect main and let an approved update initiate the Production release process."

#: src/lib/github-learning/lessons.ts:855
msgid "Production credentials and configuration belong in a secure deployment system, never in source code or a client application."
msgstr "Production credentials and configuration belong in a secure deployment system, never in source code or a client application."

#: src/lib/github-learning/lessons.ts:862
msgid "Safe promotion"
msgstr "Safe promotion"

#: src/lib/github-learning/lessons.ts:863
msgid "Move one reviewed release from Development through UAT to Production using explicit gates."
msgstr "Move one reviewed release from Development through UAT to Production using explicit gates."

#: src/lib/github-learning/lessons.ts:868
msgid "A reliable pipeline builds one version, tests it in Development, promotes the same artifact to UAT, and releases that artifact to Production after acceptance. Environment-specific configuration stays outside the build."
msgstr "A reliable pipeline builds one version, tests it in Development, promotes the same artifact to UAT, and releases that artifact to Production after acceptance. Environment-specific configuration stays outside the build."

#: src/lib/github-learning/lessons.ts:873
msgid "Begin a release by confirming exactly which branch and commit will move through the pipeline."
msgstr "Begin a release by confirming exactly which branch and commit will move through the pipeline."

#: src/lib/github-learning/lessons.ts:878
msgid "Promotion gates add confidence without rebuilding different code. If Production fails, observability and a prepared rollback reduce recovery time."
msgstr "Promotion gates add confidence without rebuilding different code. If Production fails, observability and a prepared rollback reduce recovery time."

#: src/lib/github-learning/lessons.ts:884
msgid "Prepare branches for a publishing pipeline"
msgstr "Prepare branches for a publishing pipeline"

#: src/lib/github-learning/lessons.ts:886
msgid "Create a develop branch from the stable main commit."
msgstr "Create a develop branch from the stable main commit."

#: src/lib/github-learning/lessons.ts:887
msgid "Create a release/uat branch from the same reviewed commit."
msgstr "Create a release/uat branch from the same reviewed commit."

#: src/lib/github-learning/lessons.ts:888
msgid "Publish both environment branches to origin."
msgstr "Publish both environment branches to origin."

#: src/lib/github-learning/lessons.ts:889
msgid "Leave origin/main stable and the working tree clean."
msgstr "Leave origin/main stable and the working tree clean."

#: src/lib/github-learning/lessons.ts:892
msgid "Use git branch followed by each branch name."
msgstr "Use git branch followed by each branch name."

#: src/lib/github-learning/lessons.ts:893
msgid "Use git push origin followed by the branch you want to publish."
msgstr "Use git push origin followed by the branch you want to publish."

