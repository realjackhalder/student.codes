# Copy this file to .env/.env.development.local to enable optional local services.
# The copied .local file is ignored by Git. Do not put real credentials in .env
# or .env.development because those files are checked in with safe local defaults.

# Full multi-language execution (optional)
# PISTON_API_KEY=

# Analytics (optional)
# PUBLIC_POSTHOG_KEY=

# Discord bot development (optional)
# DISCORD_CLIENT_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_CLIENT_SECRET=
# DISCORD_TOKEN=
